#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_INPUT="${1:-}"
TASK_INPUT="${2:-}"
[[ -n "$ROOT_INPUT" && -n "$TASK_INPUT" ]] || { echo "Usage: ai-opencode-exec <repo> <task.md>" >&2; exit 64; }
ROOT="$(cd "$ROOT_INPUT" && pwd -P)"
TASK="$(cd "$(dirname "$TASK_INPUT")" && pwd -P)/$(basename "$TASK_INPUT")"
[[ -d "$ROOT" ]] || { echo "REPO_NOT_FOUND=$ROOT" >&2; exit 66; }
[[ -f "$TASK" ]] || { echo "TASK_NOT_FOUND=$TASK" >&2; exit 66; }

STATE_ROOT="${AI_SUPERVISOR_HOME:-$HOME/.local/share/ai-supervisor}"
OC_DIR="${AI_OPENCODE_LAUNCHER_DIR:-$ROOT}"
OC_MODE="${AI_OPENCODE_MODE:-ogptlw}"
OC_SH="$OC_DIR/oc.sh"
WORKFLOW_DIR="${AI_WORKFLOW_DIR:-}"

command -v git >/dev/null || { echo "COMMAND_NOT_FOUND=git" >&2; exit 69; }
command -v bash >/dev/null || { echo "COMMAND_NOT_FOUND=bash" >&2; exit 69; }
[[ -f "$OC_SH" ]] || { echo "OPENCODE_LAUNCHER_NOT_FOUND=$OC_SH" >&2; exit 66; }

REPO_HASH="$(printf '%s' "$ROOT" | sha256sum | cut -c1-12)"
REPO_KEY="$(basename "$ROOT")-$REPO_HASH"
RUN_ID="R$(date -u +%Y%m%dT%H%M%SZ)-$$"
RUN_DIR="$STATE_ROOT/runs/$REPO_KEY/$RUN_ID"
mkdir -p "$RUN_DIR"
cp "$TASK" "$RUN_DIR/TASK.md"
sha256sum "$RUN_DIR/TASK.md" > "$RUN_DIR/task.sha256"

branch(){ git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null || printf 'DETACHED\n'; }
headsha(){ git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'UNBORN\n'; }
branch > "$RUN_DIR/branch-before.txt"
headsha > "$RUN_DIR/head-before.txt"
git -C "$ROOT" status --porcelain=v2 --branch > "$RUN_DIR/git-status-before.txt" || true
git -C "$ROOT" diff > "$RUN_DIR/git-diff-before.patch" || true
git -C "$ROOT" diff --cached > "$RUN_DIR/git-diff-cached-before.patch" || true

cat > "$RUN_DIR/environment.txt" <<ENV
run_id=$RUN_ID
repo_input=$ROOT_INPUT
task_input=$TASK_INPUT
started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
repo=$ROOT
task=$TASK
opencode_launcher=$OC_SH
opencode_launcher_dir=$OC_DIR
opencode_mode=$OC_MODE
ENV

mkdir -p "$STATE_ROOT"
ln -sfn "$RUN_DIR" "$STATE_ROOT/latest"
printf '%s\n' "$RUN_DIR" > "$STATE_ROOT/latest.path"
if [[ -n "$WORKFLOW_DIR" ]]; then
  ln -sfn "$RUN_DIR" "$WORKFLOW_DIR/executor-latest"
  printf '%s\n' "$RUN_DIR" > "$WORKFLOW_DIR/executor-latest.path"
fi

PROMPT='Implement the attached TASK.md completely.

Execution contract:
- Work only toward the attached task.
- Use available OMO agents/categories and relevant skills when useful.
- Preserve unrelated user changes.
- Diagnose root causes rather than masking failures.
- Run relevant verification/tests.
- Do not commit or push unless TASK.md explicitly requires it.
- Do not claim success without direct verification.
- Finish with a concise description of changes, verification, and any blocker.'

set +e
(
  cd "$OC_DIR"
  bash ./oc.sh "$OC_MODE" run \
    --auto \
    --dir "$ROOT" \
    --file "$RUN_DIR/TASK.md" \
    --format json \
    --title "ai-supervisor-$RUN_ID" \
    "$PROMPT"
) > "$RUN_DIR/opencode.jsonl" 2> "$RUN_DIR/opencode.stderr"
RC=$?
set -e

branch > "$RUN_DIR/branch-after.txt"
headsha > "$RUN_DIR/head-after.txt"
git -C "$ROOT" status --porcelain=v2 --branch > "$RUN_DIR/git-status-after.txt" || true
git -C "$ROOT" diff > "$RUN_DIR/git-diff-after.patch" || true
git -C "$ROOT" diff --cached > "$RUN_DIR/git-diff-cached-after.patch" || true

python3 - "$RUN_DIR" "$ROOT" "$TASK" "$RC" "$REPO_KEY" "$RUN_ID" <<'PY'
import json,sys
from pathlib import Path
run=Path(sys.argv[1]); root,task,rc,repo_key,run_id=sys.argv[2:]
rc=int(rc)
def txt(n):
 p=run/n
 return p.read_text(errors='replace').strip() if p.exists() else None
out={
 "run_id":run_id,"repo_key":repo_key,"repo":root,"task":task,
 "opencode_exit_code":rc,
 "execution_status":"EXECUTION_OK" if rc==0 else "EXECUTION_FAILED",
 "failure_reason":None if rc==0 else f"OpenCode exited with code {rc}",
 "branch_before":txt('branch-before.txt'),"branch_after":txt('branch-after.txt'),
 "head_before":txt('head-before.txt'),"head_after":txt('head-after.txt'),
 "git_status_before":txt('git-status-before.txt'),"git_status_after":txt('git-status-after.txt'),
 "evidence_dir":str(run),"verdict":"REQUIRES_SUPERVISOR_REVIEW"
}
(run/'result.json').write_text(json.dumps(out,indent=2)+"\n")
PY

cat "$RUN_DIR/result.json"
exit "$RC"
